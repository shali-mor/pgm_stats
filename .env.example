# Copy to .env and fill in your credentials
JIRA_URL=https://forcepoint.atlassian.net
JIRA_EMAIL=your-email@forcepoint.com
JIRA_TOKEN=your_atlassian_api_token

# Optional overrides
# JIRA_CUSTOMER_FIELD=customfield_10400   # custom field ID for "Customer Name"
# STALE_DAYS=30                           # issues not updated in N days → stalled
